# 微信后台配置的自定义 Token (必须与公众号后台保持完全一致)
WECHAT_TOKEN=mywechat2025

# 微信公众号 AppID (来自公众号后台基本配置)
WECHAT_APPID=wx2b8b8f0820e0c480

# 微信公众号 AppSecret (可选，用于后续调用主动接口如创建自定义菜单)
WECHAT_APPSECRET=

# 验证码有效时间（秒，默认 300 秒即 5 分钟）
CODE_EXPIRE_SECONDS=300

# 每次被动回复时附带的个人广告或推广文案
AD_CONTENT="-------------------\n🌟 推荐站点：实用工具导航站（https://example.com）"
